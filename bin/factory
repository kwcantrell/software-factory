#!/usr/bin/env python3
"""factory - the software factory's state machine.

Every job lives in <repo>/factory/jobs/<id>/ as a job.json plus the markdown
files the agents hand each other. This CLI is the only writer of job.json and
the only way a job changes stage, so the gates below hold no matter what a
prompt says.

    intake -> build -> proof -> review -> ship -> done

Exit codes: 0 ok, 1 refused (a gate was not met), 2 escalated to a human.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

STAGES = ["intake", "build", "proof", "review", "ship", "done"]
# Defaults; a project overrides them in factory.json at the repository root.
DEFAULTS = {
    "reviewers": ["security", "standards", "behavior"],
    "max_review_rounds": 3,
    "max_proof_attempts": 3,
    "spec_gate": False,
}
PLUGIN_ROOT = Path(__file__).resolve().parent.parent


class Refused(Exception):
    """A gate was not met."""


class Escalated(Exception):
    """The job was handed to a human."""


# ---------------------------------------------------------------- git / paths

def git(*args, cwd=None, check=True):
    p = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise Refused(f"git {' '.join(args)} failed: {p.stderr.strip() or p.stdout.strip()}")
    return p.stdout.strip()


def main_checkout():
    """The repo's primary working tree, even when called from a job worktree."""
    p = subprocess.run(["git", "worktree", "list", "--porcelain"], capture_output=True, text=True)
    if p.returncode != 0 or not p.stdout.startswith("worktree "):
        raise Refused("not inside a git repository (the factory isolates builds in git worktrees)")
    return Path(p.stdout.splitlines()[0][len("worktree "):])


def factory_dir():
    env = os.environ.get("FACTORY_DIR")
    return Path(env).resolve() if env else main_checkout() / "factory"


def ensure(root):
    """Create the factory directory. Idempotent; refreshes the dashboard."""
    (root / "jobs").mkdir(parents=True, exist_ok=True)
    ignore = root / ".gitignore"
    if not ignore.exists():
        ignore.write_text("# Factory runtime state: job records, worktrees, dashboard copy.\n*\n")
    src, dst = PLUGIN_ROOT / "dashboard" / "index.html", root / "index.html"
    if src.exists() and (not dst.exists() or src.read_bytes() != dst.read_bytes()):
        shutil.copyfile(src, dst)
    return root


def config_path(root):
    return root.parent / "factory.json"


def load_config(root):
    cfg, path = dict(DEFAULTS), config_path(root)
    if not path.exists():
        return cfg
    try:
        user = json.loads(path.read_text())
    except ValueError as e:
        raise Refused(f"{path} is not valid JSON: {e}")
    if not isinstance(user, dict):
        raise Refused(f"{path} must be a JSON object")
    for key, value in user.items():
        if key not in DEFAULTS:
            raise Refused(f"{path}: unknown key '{key}' (known: {', '.join(DEFAULTS)})")
        if key == "reviewers":
            ok = (isinstance(value, list) and value and len(set(value)) == len(value)
                  and all(isinstance(r, str) and re.fullmatch(r"[a-z0-9][a-z0-9-]*", r) for r in value))
            if not ok:
                raise Refused(f"{path}: 'reviewers' must be a non-empty list of unique "
                              f"lowercase names like \"security\"")
        elif key == "spec_gate":
            if not isinstance(value, bool):
                raise Refused(f"{path}: 'spec_gate' must be true or false")
        elif not (isinstance(value, int) and not isinstance(value, bool) and value >= 1):
            raise Refused(f"{path}: '{key}' must be a whole number of at least 1")
        cfg[key] = value
    return cfg


# ---------------------------------------------------------------- job storage

def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


@contextmanager
def locked(root):
    with open(root / ".lock", "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def resolve(root, ref):
    """Accept a full id, its number ('7', '007') or any unique prefix."""
    ids = sorted(p.name for p in (root / "jobs").iterdir() if (p / "job.json").exists())
    if ref in ids:
        return ref
    hits = [i for i in ids if i.startswith(ref)]
    if ref.isdigit():
        hits = [i for i in ids if i.split("-")[0].isdigit() and int(i.split("-")[0]) == int(ref)]
    if len(hits) == 1:
        return hits[0]
    raise Refused(f"no job matches '{ref}'" if not hits else f"'{ref}' is ambiguous: {', '.join(hits)}")


def load(root, job_id):
    return json.loads((root / "jobs" / job_id / "job.json").read_text())


def save(root, job):
    job["updated"] = now()
    path = root / "jobs" / job["id"] / "job.json"
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(job, indent=2) + "\n")
    os.replace(tmp, path)  # atomic: the dashboard never reads a half-written file


@contextmanager
def editing(root, ref):
    """Load a job under the lock; save it on exit, including on escalation."""
    with locked(root):
        job = load(root, resolve(root, ref))
        try:
            yield job
        except Escalated:
            save(root, job)
            raise
        save(root, job)


def log(job, event):
    job["activity"] = event
    job["history"].append({"at": now(), "stage": job["stage"], "event": event})


def move(job, stage, event):
    job["stage"] = stage
    log(job, event)


def need_human(job, reason):
    job["status"] = "needs-human"
    job["needs_human"] = reason
    log(job, f"needs human: {reason}")


def require_stage(job, *stages):
    if job["stage"] not in stages:
        raise Refused(f"{job['id']} is in '{job['stage']}', expected {' or '.join(stages)}")
    if job["status"] == "needs-human" and job["stage"] != "ship":
        raise Refused(f"{job['id']} is waiting on a human ({job['needs_human']}); "
                      f"a human runs `factory resume {job['id']}` to continue")


def require_contract(root, job):
    path = require_file(root, job, "task.md")
    if not re.search(r"^#+\s*acceptance criteria", path.read_text(), re.I | re.M):
        raise Refused("task.md needs an '## Acceptance criteria' section - it is the contract "
                      "the verifier and reviewers judge against")
    return hashlib.sha256(path.read_bytes()).hexdigest()


def require_file(root, job, name):
    path = root / "jobs" / job["id"] / name
    if not path.exists() or not path.read_text().strip():
        raise Refused(f"missing {path} - write it first")
    return path


# ------------------------------------------------------------------- commands

def cmd_init(root, a):
    print(f"factory ready at {root}\ndashboard: factory dashboard")


def cmd_new(root, a):
    title = " ".join(a.title).strip()
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].strip("-") or "job"
    with locked(root):
        nums = [int(p.name.split("-")[0]) for p in (root / "jobs").iterdir()
                if p.name.split("-")[0].isdigit()]
        job_id = f"{max(nums, default=0) + 1:03d}-{slug}"
        (root / "jobs" / job_id).mkdir()
        job = {"id": job_id, "title": title, "stage": "intake", "status": "active",
               "needs_human": None, "activity": "", "spec": None, "spec_sha": None,
               "branch": None, "base": None,
               "base_branch": None, "worktree": None, "proof_attempts": 0,
               "rounds": [], "created": now(), "history": []}
        log(job, "created")
        save(root, job)
    print(f"{job_id}\njob dir: {root / 'jobs' / job_id}\nnext: write task.md there, then `factory start {job_id}`")


def cmd_start(root, a):
    with editing(root, a.job) as job:
        if job["stage"] == "intake" and job.get("spec") == "pending":
            raise Refused(f"{job['id']} is waiting for a human to approve its spec (task.md)")
        require_stage(job, "intake")
        sha = require_contract(root, job)
        if a.cfg["spec_gate"] and job.get("spec") != "approved":
            raise Refused(f"spec_gate is on: run `factory spec {job['id']}` and wait for a human "
                          f"to approve task.md")
        if job.get("spec") == "approved" and sha != job.get("spec_sha"):
            raise Refused("task.md changed after the human approved it; run "
                          f"`factory spec {job['id']}` to ask for approval of the new version")
        main = main_checkout()
        if git("rev-parse", "--verify", "-q", "HEAD", cwd=main, check=False) == "":
            raise Refused("the repository has no commits yet; make an initial commit first")
        job["base"] = git("rev-parse", "HEAD", cwd=main)
        job["base_branch"] = git("symbolic-ref", "--short", "-q", "HEAD", cwd=main, check=False) or None
        job["branch"] = f"factory/{job['id']}"
        wt = root / "worktrees" / job["id"]
        git("worktree", "add", "-b", job["branch"], str(wt), job["base"], cwd=main)
        job["worktree"] = str(wt)
        move(job, "build", "building")
    print(f"worktree: {wt}\nbranch: {job['branch']}\nbase: {job['base']}")


def cmd_spec(root, a):
    with editing(root, a.job) as job:
        if job["stage"] != "intake":
            raise Refused(f"{job['id']} is in '{job['stage']}'; a spec is approved before building")
        require_contract(root, job)
        job["spec"], job["spec_sha"] = "pending", None
        need_human(job, "review task.md and approve the spec")
    print(f"{job['id']} is waiting for spec approval; the user runs /factory:approve {job['id']}")


def cmd_approve(root, a):
    """A human gate. hooks/human-gate.sh makes Claude Code ask before this runs."""
    with editing(root, a.job) as job:
        if job["stage"] != "intake" or job.get("spec") != "pending":
            raise Refused(f"{job['id']} has no spec waiting for approval")
        job["spec"], job["spec_sha"] = "approved", require_contract(root, job)
        job["status"], job["needs_human"] = "active", None
        log(job, "spec approved by human")
    print(f"{job['id']} spec approved; next: factory start {job['id']}")


def cmd_built(root, a):
    with editing(root, a.job) as job:
        require_stage(job, "build")
        require_file(root, job, "build.md")
        wt = job["worktree"]
        if git("status", "--porcelain", cwd=wt):
            raise Refused(f"uncommitted changes in {wt} - commit them; reviewers read commits")
        if git("rev-list", "--count", f"{job['base']}..HEAD", cwd=wt) == "0":
            raise Refused(f"no commits on {job['branch']} since {job['base'][:8]}")
        move(job, "proof", "awaiting independent proof")
    print(f"{job['id']} -> proof")


def cmd_proof(root, a):
    with editing(root, a.job) as job:
        require_stage(job, "proof")
        require_file(root, job, "proof.md")
        if a.result == "pass":
            move(job, "review", "proof passed")
        else:
            job["proof_attempts"] += 1
            move(job, "build", f"proof failed (attempt {job['proof_attempts']})")
            if job["proof_attempts"] >= a.cfg["max_proof_attempts"]:
                need_human(job, f"proof failed {job['proof_attempts']} times - see proof.md")
                raise Escalated(job["needs_human"])
    print(f"{job['id']} -> {job['stage']}")


def cmd_round(root, a):
    with editing(root, a.job) as job:
        require_stage(job, "review")
        rounds = job["rounds"]
        if rounds and any(v["verdict"] is None for v in rounds[-1]["reviewers"].values()):
            raise Refused(f"round {rounds[-1]['n']} is still waiting on verdicts")
        n = len(rounds) + 1
        if n > a.cfg["max_review_rounds"]:
            need_human(job, f"no approval after {a.cfg['max_review_rounds']} review round(s)")
            raise Escalated(job["needs_human"])
        names = a.reviewers or a.cfg["reviewers"]
        rounds.append({"n": n, "reviewers": {r: {"verdict": None, "at": None} for r in names}})
        log(job, f"review round {n} opened")
    print(f"round {n}: {' '.join(names)}")


def cmd_verdict(root, a):
    with editing(root, a.job) as job:
        require_stage(job, "review")
        if not job["rounds"]:
            raise Refused("no review round is open - run `factory round` first")
        rnd = job["rounds"][-1]
        slot = rnd["reviewers"].get(a.reviewer)
        if slot is None:
            raise Refused(f"'{a.reviewer}' is not a reviewer in round {rnd['n']} "
                          f"({', '.join(rnd['reviewers'])})")
        if slot["verdict"] is not None:
            raise Refused(f"{a.reviewer} already recorded '{slot['verdict']}' for round {rnd['n']}")
        require_file(root, job, f"review-{rnd['n']}-{a.reviewer}.md")
        slot.update(verdict=a.verdict, at=now())
        log(job, f"round {rnd['n']}: {a.reviewer} -> {a.verdict}")
        verdicts = [v["verdict"] for v in rnd["reviewers"].values()]
        if None not in verdicts:
            blockers = [r for r, v in rnd["reviewers"].items() if v["verdict"] == "changes"]
            if not blockers:
                move(job, "ship", f"approved in round {rnd['n']}")
                need_human(job, "approved by every reviewer - awaiting your merge")
            elif rnd["n"] >= a.cfg["max_review_rounds"]:
                need_human(job, f"changes still requested after {rnd['n']} round{'s'[:rnd['n'] != 1]} "
                                f"({', '.join(blockers)})")
                raise Escalated(job["needs_human"])
            else:
                move(job, "build", f"round {rnd['n']}: changes requested by {', '.join(blockers)}")
    print(f"{job['id']}: {a.reviewer} -> {a.verdict} (stage: {job['stage']})")


def cmd_human(root, a):
    with editing(root, a.job) as job:
        need_human(job, " ".join(a.reason))
    print(f"{job['id']} flagged for a human")


def cmd_resume(root, a):
    with editing(root, a.job) as job:
        if job["stage"] in ("ship", "done"):
            raise Refused(f"{job['id']} is in '{job['stage']}'; use `factory merge` or `factory close`")
        job["status"], job["needs_human"] = "active", None
        if a.reset:
            job["proof_attempts"] = 0
            job["rounds"] = []
        log(job, "resumed by human" + (" (attempt and round counters reset)" if a.reset else ""))
    print(f"{job['id']} resumed in {job['stage']}")


def drop_worktree(job, keep_branch):
    main = main_checkout()
    if job.get("worktree") and Path(job["worktree"]).exists():
        git("worktree", "remove", "--force", job["worktree"], cwd=main, check=False)
    if job.get("branch") and not keep_branch:
        git("branch", "-d", job["branch"], cwd=main, check=False)
    job["worktree"] = None


def cmd_merge(root, a):
    """The human gate. hooks/human-gate.sh makes Claude Code ask before this runs."""
    with editing(root, a.job) as job:
        require_stage(job, "ship")
        main = main_checkout()
        if git("status", "--porcelain", "--untracked-files=no", cwd=main):
            raise Refused(f"{main} has uncommitted changes; commit or stash them before merging")
        current = git("symbolic-ref", "--short", "-q", "HEAD", cwd=main, check=False) or "(detached)"
        if job["base_branch"] and current != job["base_branch"] and not a.into_current:
            raise Refused(f"main checkout is on '{current}' but the job was cut from "
                          f"'{job['base_branch']}'; check that out, or pass --into-current")
        p = subprocess.run(["git", "merge", "--no-ff", "-m",
                            f"Merge {job['branch']}: {job['title']}", job["branch"]],
                           cwd=main, capture_output=True, text=True)
        if p.returncode != 0:
            git("merge", "--abort", cwd=main, check=False)
            need_human(job, f"merge into {current} conflicts - the branch needs a rebase")
            raise Escalated(job["needs_human"] + "\n" + (p.stdout + p.stderr).strip())
        drop_worktree(job, keep_branch=False)
        job["status"], job["needs_human"] = "merged", None
        move(job, "done", f"merged into {current}")
    print(f"{job['id']} merged into {current}")


def cmd_rework(root, a):
    with editing(root, a.job) as job:
        require_stage(job, "ship")
        reason = " ".join(a.reason).strip()
        if not reason:
            raise Refused("say what to change: factory rework <job> <what to change>")
        n = len(job["rounds"])
        note = root / "jobs" / job["id"] / f"rework-{n}.md"
        note.write_text(f"# Rework requested after round {n}\n\nRequested by a human at {now()}.\n\n{reason}\n")
        job["status"], job["needs_human"] = "active", None
        move(job, "build", f"rework requested by a human after round {n}: {reason}")
    print(f"{job['id']} -> build (rework; request in {note.name})")


def cmd_close(root, a):
    with editing(root, a.job) as job:
        if job["stage"] == "done":
            raise Refused(f"{job['id']} is already done")
        drop_worktree(job, keep_branch=True)
        job["status"], job["needs_human"] = "closed", None
        reason = " ".join(a.reason) or "closed"
        move(job, "done", f"closed without merging: {reason}")
    kept = f" (branch {job['branch']} kept)" if job["branch"] else ""
    print(f"{job['id']} closed{kept}")


def cmd_config(root, a):
    path = config_path(root)
    source = str(path) if path.exists() else f"defaults (create {path} to override)"
    print(json.dumps(a.cfg, indent=2))
    print(f"# from {source}", file=sys.stderr)


def cmd_note(root, a):
    with editing(root, a.job) as job:
        log(job, " ".join(a.text))


def cmd_path(root, a):
    job = load(root, resolve(root, a.job))
    print(job["worktree"] or "" if a.worktree else root / "jobs" / job["id"])


def cmd_status(root, a):
    ids = [resolve(root, a.job)] if a.job else sorted(
        p.name for p in (root / "jobs").iterdir() if (p / "job.json").exists())
    jobs = [load(root, i) for i in ids]
    if a.json:
        print(json.dumps(jobs if not a.job else jobs[0], indent=2))
        return
    if not jobs:
        print("no jobs yet")
    for j in jobs:
        flag = f"  !! {j['needs_human']}" if j["status"] == "needs-human" else ""
        rounds = " ".join(
            "r%d[%s]" % (r["n"], "".join({"approve": "+", "changes": "x", None: "."}[v["verdict"]]
                                         for v in r["reviewers"].values())) for r in j["rounds"])
        print(f"{j['id']:<46} {j['stage']:<7} {j['status']:<11} {rounds}{flag}")
        if a.job:
            print(f"  title:    {j['title']}\n  job dir:  {root / 'jobs' / j['id']}\n"
                  f"  worktree: {j['worktree']}\n  branch:   {j['branch']}  base: {j['base']}\n"
                  f"  activity: {j['activity']}")


def stats(jobs):
    # Line metrics, derived from each job's history. The dashboard computes the same.
    def parse(iso):
        return datetime.strptime(iso, "%Y-%m-%dT%H:%M:%SZ")
    first_proofs, rounds, hours, escalated = [], [], [], 0
    for j in jobs:
        events = j["history"]
        proofs = [h["event"] for h in events if h["event"].startswith(("proof passed", "proof failed"))]
        if proofs:
            first_proofs.append(proofs[0].startswith("proof passed"))
        approved = next((h for h in events if h["event"].startswith("approved in round ")), None)
        if approved:
            rounds.append(int(approved["event"].rsplit(" ", 1)[1]))
            hours.append((parse(approved["at"]) - parse(j["created"])).total_seconds() / 3600)
        escalated += any(h["event"].startswith("needs human:")
                         and not h["event"].startswith("needs human: approved") for h in events)
    hours.sort()
    return {
        "jobs": len(jobs),
        "approved": len(rounds),
        "first_pass_proof_rate": round(sum(first_proofs) / len(first_proofs), 2) if first_proofs else None,
        "avg_review_rounds": round(sum(rounds) / len(rounds), 2) if rounds else None,
        "first_round_approval_rate": round(rounds.count(1) / len(rounds), 2) if rounds else None,
        "median_hours_to_approval": round(hours[len(hours) // 2], 2) if hours else None,
        "escalation_rate": round(escalated / len(jobs), 2) if jobs else None,
    }


def cmd_stats(root, a):
    jobs = [load(root, p.name) for p in sorted((root / "jobs").iterdir()) if (p / "job.json").exists()]
    s = stats(jobs)
    if a.json:
        print(json.dumps(s, indent=2))
        return
    pct = lambda v: "-" if v is None else f"{v:.0%}"
    num = lambda v, unit="": "-" if v is None else f"{v:g}{unit}"
    print(f"jobs                        {s['jobs']} ({s['approved']} approved)\n"
          f"first-pass proof            {pct(s['first_pass_proof_rate'])}\n"
          f"approved in first round     {pct(s['first_round_approval_rate'])}\n"
          f"review rounds to approval   {num(s['avg_review_rounds'])} avg\n"
          f"time to approval            {num(s['median_hours_to_approval'], 'h')} median\n"
          f"escalated to a human        {pct(s['escalation_rate'])}")


def cmd_dashboard(root, a):
    print(f"dashboard: http://127.0.0.1:{a.port}/  (serving {root}, Ctrl-C to stop)", flush=True)
    os.execvp(sys.executable, [sys.executable, "-m", "http.server", str(a.port),
                               "--bind", "127.0.0.1", "--directory", str(root)])


# ----------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="factory", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help, *args):
        sp = sub.add_parser(name, help=help)
        for flags, kw in args:
            sp.add_argument(*flags, **kw)
        sp.set_defaults(fn=fn)

    JOB = (["job"], {"help": "job id, number or unique prefix"})
    add("init", cmd_init, "create ./factory and install the dashboard")
    add("new", cmd_new, "intake: open a job", (["title"], {"nargs": "+"}))
    add("start", cmd_start, "intake -> build: needs task.md; creates the worktree", JOB)
    add("spec", cmd_spec, "ask a human to approve task.md before building", JOB)
    add("approve", cmd_approve, "human gate: approve a job's spec", JOB)
    add("built", cmd_built, "build -> proof: needs build.md and clean commits", JOB)
    add("proof", cmd_proof, "verifier's result: pass -> review, fail -> build", JOB,
        (["result"], {"choices": ["pass", "fail"]}))
    add("round", cmd_round, "open a review round", JOB,
        (["reviewers"], {"nargs": "*", "help": "default: the reviewers in factory.json"}))
    add("verdict", cmd_verdict, "a reviewer's verdict; needs review-<round>-<reviewer>.md", JOB,
        (["reviewer"], {}), (["verdict"], {"choices": ["approve", "changes"]}))
    add("human", cmd_human, "flag a job as needing a human", JOB, (["reason"], {"nargs": "+"}))
    add("resume", cmd_resume, "human: clear needs-human and continue", JOB,
        (["--reset"], {"action": "store_true", "help": "also reset proof attempts and review rounds"}))
    add("merge", cmd_merge, "human gate: merge an approved job and clean up", JOB,
        (["--into-current"], {"action": "store_true"}))
    add("rework", cmd_rework, "human: send an approved job back to build", JOB,
        (["reason"], {"nargs": "+", "help": "what to change; saved as rework-<round>.md"}))
    add("close", cmd_close, "human: abandon a job without merging", JOB, (["reason"], {"nargs": "*"}))
    add("config", cmd_config, "print the effective configuration (factory.json over defaults)")
    add("note", cmd_note, "set the job's activity line", JOB, (["text"], {"nargs": "+"}))
    add("path", cmd_path, "print the job dir (or --worktree)", JOB,
        (["--worktree"], {"action": "store_true"}))
    add("status", cmd_status, "list jobs, or show one", (["job"], {"nargs": "?"}),
        (["--json"], {"action": "store_true"}))
    add("stats", cmd_stats, "line metrics: proof and review pass rates, rounds, time, escalations",
        (["--json"], {"action": "store_true"}))
    add("dashboard", cmd_dashboard, "serve the dashboard",
        (["--port"], {"type": int, "default": 8787}))

    a = ap.parse_args()
    try:
        root = ensure(factory_dir())
        a.cfg = load_config(root)
        a.fn(root, a)
    except Refused as e:
        sys.exit(f"refused: {e}")
    except Escalated as e:
        print(f"escalated to a human: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
