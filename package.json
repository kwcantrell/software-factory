{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Software Factory marketplace: dev tooling only (typecheck, tests). Plugins never depend on the root.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=120000 'plugins/*/test/**/*.test.ts' 'templates/*/test/**/*.test.ts'",
    "new-plugin": "node plugins/factory-plugin-builder/src/cli.ts new"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
